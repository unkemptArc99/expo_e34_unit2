{
  "name": "interview-question-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts tests/*.test.tsx",
    "ingest": "node --import tsx scripts/ingest.ts",
    "refresh": "node --import tsx scripts/ingest.ts --refresh",
    "check:publish": "node --import tsx scripts/check-publish.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0"
  }
}
